digraph AuditLab {
  graph [rankdir=LR, bgcolor="#DAD7C0", pad=0.4, nodesep=0.55, ranksep=0.9,
         fontname="DejaVu Sans", fontsize=25, label="AUDITLAB · ARQUITECTURA", labelloc=t];
  node [shape=box, style=filled, fillcolor="#F3EFDD", color="#26271F", penwidth=1.6,
        fontname="DejaVu Sans", fontsize=18, margin="0.24,0.22"];
  edge [color="#4F5141", penwidth=1.8, fontname="DejaVu Sans", fontsize=14, arrowsize=0.8];
  agente [label="AGENTE · ANDROID\nConsentimiento y captura\nRoom + WorkManager"];
  centro [label="CENTRO · ANDROID\nLogin y roles\nConsulta, reportes y revocación"];
  {rank=same; agente; centro;}
  subgraph cluster_servidor {
    label="PC O SERVIDOR CENTRAL"; fontsize=19; color="#6B6B56"; penwidth=1.3; margin=24;
    api [label="API REST · KTOR\nAutenticación y validación\nAcceso mediante HTTPS", fillcolor="#10110E", fontcolor="#F3EFDD"];
    postgres [shape=cylinder, label="POSTGRESQL\nEventos y SMS autorizados\nUsuarios, consentimientos\ny auditoría"];
    memoria [label="MEMORIA TEMPORAL\nVistas previas WhatsApp\ny cuadros de pantalla"];
    {rank=same; postgres; memoria;}
    api -> postgres [dir=both, label="Datos persistentes"];
    api -> memoria [dir=both, label="Contenido por sesión"];
  }
  agente -> api [label="HTTPS\nEventos y sesiones opcionales"];
  centro -> api [dir=both, label="HTTPS\nConsultas autenticadas"];
}
